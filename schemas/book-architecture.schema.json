{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/arthamegayasa/nam-book-studio/main/skills/asknam/references/schemas/book-architecture.schema.json",
  "title": "Nam Book architecture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "locale",
    "profile",
    "reader_promise",
    "scope",
    "chapters",
    "input_artifacts",
    "produced_by",
    "status",
    "blockers"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "project_id": { "type": "string" },
    "locale": { "enum": ["en-US", "id-ID"] },
    "profile": { "enum": ["friendly-explainer", "textbook", "exam-prep"] },
    "reader_promise": { "type": "string", "minLength": 1 },
    "reader_prerequisites": { "type": "array", "items": { "type": "string" } },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["includes", "excludes"],
      "properties": {
        "includes": { "type": "array", "items": { "type": "string" } },
        "excludes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chapter_id", "title", "purpose", "depends_on", "objectives", "planned_claims", "planned_visuals", "planned_assessments"],
        "properties": {
          "chapter_id": { "type": "string" },
          "title": { "type": "string" },
          "purpose": { "type": "string" },
          "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "word_target": { "type": "integer", "minimum": 0 },
          "objectives": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["objective_id", "text"],
              "properties": {
                "objective_id": { "type": "string" },
                "text": { "type": "string" }
              }
            }
          },
          "planned_claims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["claim_id", "summary", "risk_level", "required_evidence_ids"],
              "properties": {
                "claim_id": { "type": "string" },
                "summary": { "type": "string" },
                "risk_level": { "enum": ["R0", "R1", "R2", "R3"] },
                "required_evidence_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
              }
            }
          },
          "planned_visuals": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["figure_id", "kind", "learning_job"],
              "properties": {
                "figure_id": { "type": "string" },
                "kind": { "enum": ["illustration", "diagram", "table", "other"] },
                "learning_job": { "type": "string" }
              }
            }
          },
          "planned_assessments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["item_id", "objective_ids", "format"],
              "properties": {
                "item_id": { "type": "string" },
                "objective_ids": { "type": "array", "items": { "type": "string" } },
                "format": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "input_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "sha256"],
        "properties": {
          "artifact_id": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "produced_by": { "const": "nam-book-architect" },
    "status": { "enum": ["draft", "review", "approved", "stale", "blocked"] },
    "blockers": { "type": "array", "items": { "type": "string" } }
  }
}
