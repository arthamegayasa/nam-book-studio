{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/arthamegayasa/nam-book-studio/main/skills/asknam/references/schemas/book-project.schema.json",
  "title": "Nam Book project manifest and state",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "risk_level": { "const": "R3" } },
        "required": ["risk_level"]
      },
      "then": {
        "properties": {
          "medical": {
            "type": "object",
            "properties": {
              "enabled": { "const": true },
              "jurisdiction": { "type": "string", "minLength": 1 },
              "evidence_cutoff": { "type": "string", "format": "date" },
              "revalidate_before_export": { "type": "string", "format": "date" }
            },
            "required": [
              "enabled",
              "jurisdiction",
              "evidence_cutoff",
              "revalidate_before_export"
            ]
          }
        }
      }
    }
  ],
  "required": [
    "$schema",
    "schema_version",
    "project_id",
    "title",
    "profile",
    "source_locale",
    "target_locales",
    "risk_level",
    "medical",
    "features",
    "deliverables",
    "artifact_registry",
    "route",
    "approvals",
    "staleness",
    "provenance",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "audience": { "type": "string" },
    "reader_outcome": { "type": "string" },
    "profile": { "enum": ["friendly-explainer", "textbook", "exam-prep"] },
    "source_locale": { "enum": ["en-US", "id-ID"] },
    "target_locales": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["en-US", "id-ID"] }
    },
    "risk_level": { "enum": ["R0", "R1", "R2", "R3"] },
    "medical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "jurisdiction", "evidence_cutoff", "revalidate_before_export"],
      "properties": {
        "enabled": { "type": "boolean" },
        "jurisdiction": { "type": ["string", "null"] },
        "evidence_cutoff": { "type": ["string", "null"], "format": "date" },
        "revalidate_before_export": { "type": ["string", "null"], "format": "date" }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessments", "illustrations", "diagrams", "visual_density"],
      "properties": {
        "assessments": { "type": "boolean" },
        "illustrations": { "type": "boolean" },
        "diagrams": { "type": "boolean" },
        "visual_density": { "enum": ["low", "medium", "high"] }
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["markdown", "docx", "pdf", "epub"] }
    },
    "artifact_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "slots", "entries"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "slots": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "cardinality", "produced_by", "operations", "required"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "cardinality": { "enum": ["one", "many"] },
              "produced_by": { "type": "string" },
              "required": { "type": "boolean" },
              "operations": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string" }
              }
            }
          }
        },
        "entries": {
          "type": "array",
          "items": { "$ref": "book-artifact.schema.json" }
        }
      }
    },
    "route": { "$ref": "book-route.schema.json" },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approval_id",
          "kind",
          "status",
          "requested_at",
          "decided_at",
          "decided_by",
          "reviewer_role",
          "reviewer_credentials",
          "note",
          "basis"
        ],
        "properties": {
          "approval_id": { "type": "string" },
          "kind": {
            "enum": ["project-brief", "architecture", "illustration-setup", "character-bible", "source-content-lock", "medical-expert-signoff", "final-proof"]
          },
          "status": { "enum": ["pending", "approved", "rejected", "expired"] },
          "requested_at": { "type": "string", "format": "date-time" },
          "decided_at": { "type": ["string", "null"], "format": "date-time" },
          "decided_by": { "type": ["string", "null"] },
          "reviewer_role": { "type": ["string", "null"] },
          "reviewer_credentials": { "type": ["string", "null"] },
          "note": { "type": "string" },
          "basis": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["artifact_id", "revision", "sha256"],
              "properties": {
                "artifact_id": { "type": "string" },
                "revision": { "type": "integer", "minimum": 1 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            }
          }
        }
      }
    },
    "staleness": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stale_id", "artifact_id", "reason", "detected_at", "invalidates_nodes"],
        "properties": {
          "stale_id": { "type": "string" },
          "artifact_id": { "type": "string" },
          "reason": { "type": "string" },
          "detected_at": { "type": "string", "format": "date-time" },
          "invalidates_nodes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "resolved_nodes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "resolved_at": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "kind", "name", "origin", "license"],
        "properties": {
          "item_id": { "type": "string" },
          "kind": { "enum": ["skill", "template", "image", "font", "reference", "quotation", "other"] },
          "name": { "type": "string" },
          "origin": { "type": "string" },
          "license": { "type": "string" },
          "notice_path": { "type": ["string", "null"] },
          "notes": { "type": "string" }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
