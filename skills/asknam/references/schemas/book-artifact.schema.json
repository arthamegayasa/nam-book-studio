{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/arthamegayasa/nam-book-studio/main/skills/asknam/references/schemas/book-artifact.schema.json",
  "title": "Nam Book artifact registry entry",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "blocked" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "blockers": { "type": "array", "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": { "blockers": { "type": "array", "minItems": 1 } },
        "required": ["blockers"]
      },
      "then": {
        "properties": { "status": { "const": "blocked" } }
      }
    }
  ],
  "required": [
    "schema_version",
    "artifact_id",
    "kind",
    "path",
    "project_id",
    "locale",
    "produced_by",
    "producer_node",
    "operation",
    "status",
    "revision",
    "sha256",
    "hash_kind",
    "inputs",
    "claim_ids",
    "source_ids",
    "objective_ids",
    "figure_ids",
    "item_ids",
    "semantic_block_ids",
    "blockers",
    "provenance",
    "revision_history",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "kind": { "type": "string", "minLength": 1 },
    "path": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:[A-Za-z]:|/|\\\\|.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))" }
    },
    "project_id": { "type": "string", "minLength": 1 },
    "chapter_id": { "type": ["string", "null"] },
    "locale": { "enum": ["en-US", "id-ID"] },
    "produced_by": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "producer_node": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "enum": ["draft", "review", "approved", "locked", "stale", "blocked"]
    },
    "revision": { "type": "integer", "minimum": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "hash_kind": { "enum": ["sha256-file", "sha256-tree-v1"] },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "revision", "sha256"],
        "properties": {
          "artifact_id": { "type": "string" },
          "revision": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "claim_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "source_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "objective_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "figure_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "item_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "semantic_block_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "creator", "license", "source_url", "notice_path"],
      "properties": {
        "origin": { "type": "string" },
        "creator": { "type": "string" },
        "license": { "type": "string" },
        "source_url": { "type": "string" },
        "notice_path": { "type": "string" }
      }
    },
    "revision_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "sha256",
          "hash_kind",
          "snapshot_path",
          "status",
          "inputs",
          "claim_ids",
          "source_ids",
          "objective_ids",
          "figure_ids",
          "item_ids",
          "semantic_block_ids",
          "blockers",
          "provenance",
          "registered_at"
        ],
        "properties": {
          "revision": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "hash_kind": { "enum": ["sha256-file", "sha256-tree-v1"] },
          "snapshot_path": { "type": "string", "minLength": 1 },
          "status": { "enum": ["draft", "review", "approved", "locked", "blocked"] },
          "inputs": { "type": "array" },
          "claim_ids": { "type": "array", "items": { "type": "string" } },
          "source_ids": { "type": "array", "items": { "type": "string" } },
          "objective_ids": { "type": "array", "items": { "type": "string" } },
          "figure_ids": { "type": "array", "items": { "type": "string" } },
          "item_ids": { "type": "array", "items": { "type": "string" } },
          "semantic_block_ids": { "type": "array", "items": { "type": "string" } },
          "blockers": { "type": "array", "items": { "type": "string" } },
          "provenance": { "type": "object" },
          "registered_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
