{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/arthamegayasa/nam-book-studio/main/skills/asknam/references/schemas/capability-catalog.schema.json",
  "title": "Nam Book capability catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skills", "capabilities"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill",
          "capability",
          "purpose",
          "invocation",
          "depends_on",
          "approval_gates",
          "produces"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "capability": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "invocation": { "enum": ["explicit", "model"] },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "approval_gates": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "route_nodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "operation",
                "purpose",
                "depends_on",
                "approval_gates",
                "produces"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "operation": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "purpose": { "type": "string", "minLength": 1 },
                "depends_on": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string" }
                },
                "approval_gates": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string" }
                },
                "produces": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string" }
                }
              }
            }
          },
          "produces": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "path", "cardinality"],
              "properties": {
                "kind": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 },
                "cardinality": { "enum": ["one", "many"] },
                "required": { "type": "boolean", "default": true }
              }
            }
          }
        }
      }
    }
  }
}
